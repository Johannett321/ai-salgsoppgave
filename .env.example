# Kopier denne filen til .env og fyll inn nøklene dine:
#
#   cp .env.example .env
#
# .env er git-ignorert. Docker Compose leser den automatisk.

# ---------------------------------------------------------------------------
# PÅKREVD – uten disse starter appen, men selve analysen feiler
# ---------------------------------------------------------------------------

# Claude leser salgsoppgaven og svarer i chatten.
# Nøkkel: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI lager embeddings som legges i pgvector.
# Nøkkel: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# VALGFRITT – alt under kan stå tomt. Da er funksjonen bare slått av.
# ---------------------------------------------------------------------------

# Innlogging med Google/Facebook. Står de tomme, brukes vanlig e-post og passord.
# Redirect-URI: <backend.url>/login/oauth2/code/google
#OAUTH2_GOOGLE_CLIENT_ID=
#OAUTH2_GOOGLE_CLIENT_SECRET=
#OAUTH2_FACEBOOK_CLIENT_ID=
#OAUTH2_FACEBOOK_CLIENT_SECRET=

# Utgående e-post, for eksempel «glemt passord».
#SPRING_MAIL_USERNAME=
#SPRING_MAIL_PASSWORD=

# Nyhetsbrev.
#MAILCHIMP_API_KEY=
#MAILCHIMP_SERVER_PREFIX=
#MAILCHIMP_LIST_ID=

# Discord-varsler ved feil og nyregistreringer.
#DISCORD_WEBHOOK_ERROR=
#DISCORD_WEBHOOK_NOTIFICATIONS=

# Hvilken Claude-modell som brukes.
#ANTHROPIC_MODEL=claude-sonnet-4-5

# debug gir detaljert logg fra applikasjonen.
#LOG_LEVEL=info
