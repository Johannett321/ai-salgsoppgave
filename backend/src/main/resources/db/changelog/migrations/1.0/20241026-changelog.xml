<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1729962705566-1" author="johansvartdal">
        <createTable tableName="bva_user">
            <column name="id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_bva_user"/>
            </column>
            <column name="facebook_id" type="VARCHAR(255)"/>
            <column name="google_sub" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="password" type="VARCHAR(255)"/>
            <column name="first_name" type="VARCHAR(255)"/>
            <column name="last_name" type="VARCHAR(255)"/>
            <column name="last_login" type="DATETIME"/>
            <column name="created_at" type="DATETIME"/>
            <column name="stripe_customer_id" type="VARCHAR(255)"/>
            <column name="had_trial" type="BOOLEAN"/>
        </createTable>
    </changeSet>
    <changeSet id="1729962705566-2" author="johansvartdal">
        <createTable tableName="chat_conversation">
            <column name="id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_chatconversation"/>
            </column>
            <column name="user_id" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="1729962705566-3" author="johansvartdal">
        <createTable tableName="chat_message">
            <column name="id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_chatmessage"/>
            </column>
            <column name="role" type="SMALLINT"/>
            <column name="timestamp" type="DATETIME"/>
            <column name="message" type="TEXT"/>
            <column name="conversation_id" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="1729962705566-4" author="johansvartdal">
        <createTable tableName="pre_registered_user">
            <column name="id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_pre_registered_user"/>
            </column>
            <column name="first_name" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="1729962705566-5" author="johansvartdal">
        <createTable tableName="reset_password">
            <column name="id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_reset_password"/>
            </column>
            <column name="email" type="VARCHAR(255)"/>
            <column name="expiration" type="BIGINT"/>
        </createTable>
    </changeSet>
    <changeSet id="1729962705566-6" author="johansvartdal">
        <createTable tableName="salgsoppgave">
            <column name="id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_salgsoppgave"/>
            </column>
            <column name="gate_navn" type="VARCHAR(255)"/>
            <column name="gate_nummer" type="VARCHAR(255)"/>
            <column name="post_nummer" type="VARCHAR(255)"/>
            <column name="post_sted" type="VARCHAR(255)"/>
            <column name="longtitude" type="DOUBLE"/>
            <column name="latitude" type="DOUBLE"/>
            <column name="pris_antydning" type="DOUBLE"/>
            <column name="total_pris" type="DOUBLE"/>
            <column name="bruks_areal" type="DOUBLE"/>
            <column name="bygge_aar" type="DOUBLE"/>
            <column name="oppsummering" type="TEXT"/>
        </createTable>
    </changeSet>
    <changeSet id="1729962705566-7" author="johansvartdal">
        <createTable tableName="salgsoppgave_bemerkning">
            <column name="id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_salgsoppgave_bemerkning"/>
            </column>
            <column name="bemerkning" type="TEXT"/>
            <column name="salgsoppgave_id" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="1729962705566-8" author="johansvartdal">
        <createTable tableName="salgsoppgave_job">
            <column name="id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_salgsoppgave_job"/>
            </column>
            <column name="start_date" type="DATETIME"/>
            <column name="job_status" type="SMALLINT"/>
            <column name="failed_reason" type="VARCHAR(255)"/>
            <column name="finn_url" type="VARCHAR(255)"/>
            <column name="finn_komplett_salgsoppgave_url" type="VARCHAR(255)"/>
            <column name="salgsoppgavepdfurl" type="VARCHAR(255)"/>
            <column name="pdf_path" type="VARCHAR(255)"/>
            <column name="pdf_content" type="TEXT"/>
            <column name="finn_content" type="TEXT"/>
            <column name="salgsoppgave_id" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="1729962705566-9" author="johansvartdal">
        <createTable tableName="stripe_session">
            <column name="id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_stripe_session"/>
            </column>
            <column name="session_id" type="VARCHAR(255)"/>
            <column name="stripe_customer_id" type="VARCHAR(255)"/>
            <column name="created_at" type="BIGINT"/>
            <column name="amount" type="DOUBLE"/>
            <column name="subscription_type" type="SMALLINT"/>
            <column name="status" type="SMALLINT"/>
            <column name="complete" type="BOOLEAN"/>
            <column name="created_by_id" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="1729962705566-10" author="johansvartdal">
        <createTable tableName="subscription">
            <column name="id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_subscription"/>
            </column>
            <column name="stripe_subscription_id" type="VARCHAR(255)"/>
            <column name="created_at" type="BIGINT"/>
            <column name="cancelled_at" type="BIGINT"/>
            <column name="status" type="SMALLINT"/>
            <column name="type" type="SMALLINT"/>
            <column name="stripe_session_id" type="VARCHAR(255)"/>
            <column name="user_id" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="1729962705566-11" author="johansvartdal">
        <createTable tableName="user_salgsoppgave_job">
            <column name="id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_usersalgsoppgavejob"/>
            </column>
            <column name="user_id" type="VARCHAR(255)"/>
            <column name="salgsoppgave_job_id" type="VARCHAR(255)"/>
            <column name="chat_conversation_id" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="1729962705566-12" author="johansvartdal">
        <createTable tableName="vector_store">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_vector_store"/>
            </column>
            <column name="content" type="text(2147483647)"/>
            <column name="metadata" type="jsonb"/>
            <column name="embedding" type="vector(1536)"/>
        </createTable>
    </changeSet>
    <changeSet id="1729962705566-13" author="johansvartdal">
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="chat_conversation"
                                 constraintName="FK_CHATCONVERSATION_ON_USER" referencedColumnNames="id"
                                 referencedTableName="bva_user"/>
    </changeSet>
    <changeSet id="1729962705566-14" author="johansvartdal">
        <addForeignKeyConstraint baseColumnNames="conversation_id" baseTableName="chat_message"
                                 constraintName="FK_CHATMESSAGE_ON_CONVERSATION" referencedColumnNames="id"
                                 referencedTableName="chat_conversation"/>
    </changeSet>
    <changeSet id="1729962705566-15" author="johansvartdal">
        <addForeignKeyConstraint baseColumnNames="salgsoppgave_id" baseTableName="salgsoppgave_bemerkning"
                                 constraintName="FK_SALGSOPPGAVE_BEMERKNING_ON_SALGSOPPGAVE" referencedColumnNames="id"
                                 referencedTableName="salgsoppgave"/>
    </changeSet>
    <changeSet id="1729962705566-16" author="johansvartdal">
        <addForeignKeyConstraint baseColumnNames="salgsoppgave_id" baseTableName="salgsoppgave_job"
                                 constraintName="FK_SALGSOPPGAVE_JOB_ON_SALGSOPPGAVE" referencedColumnNames="id"
                                 referencedTableName="salgsoppgave"/>
    </changeSet>
    <changeSet id="1729962705566-17" author="johansvartdal">
        <addForeignKeyConstraint baseColumnNames="created_by_id" baseTableName="stripe_session"
                                 constraintName="FK_STRIPE_SESSION_ON_CREATEDBY" referencedColumnNames="id"
                                 referencedTableName="bva_user"/>
    </changeSet>
    <changeSet id="1729962705566-18" author="johansvartdal">
        <addForeignKeyConstraint baseColumnNames="stripe_session_id" baseTableName="subscription"
                                 constraintName="FK_SUBSCRIPTION_ON_STRIPESESSION" referencedColumnNames="id"
                                 referencedTableName="stripe_session"/>
    </changeSet>
    <changeSet id="1729962705566-19" author="johansvartdal">
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="subscription"
                                 constraintName="FK_SUBSCRIPTION_ON_USER" referencedColumnNames="id"
                                 referencedTableName="bva_user"/>
    </changeSet>
    <changeSet id="1729962705566-20" author="johansvartdal">
        <addForeignKeyConstraint baseColumnNames="chat_conversation_id" baseTableName="user_salgsoppgave_job"
                                 constraintName="FK_USERSALGSOPPGAVEJOB_ON_CHAT_CONVERSATION" referencedColumnNames="id"
                                 referencedTableName="chat_conversation"/>
    </changeSet>
    <changeSet id="1729962705566-21" author="johansvartdal">
        <addForeignKeyConstraint baseColumnNames="salgsoppgave_job_id" baseTableName="user_salgsoppgave_job"
                                 constraintName="FK_USERSALGSOPPGAVEJOB_ON_SALGSOPPGAVEJOB" referencedColumnNames="id"
                                 referencedTableName="salgsoppgave_job"/>
    </changeSet>
    <changeSet id="1729962705566-22" author="johansvartdal">
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="user_salgsoppgave_job"
                                 constraintName="FK_USERSALGSOPPGAVEJOB_ON_USER" referencedColumnNames="id"
                                 referencedTableName="bva_user"/>
    </changeSet>

</databaseChangeLog>