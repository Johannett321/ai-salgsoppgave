<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Slår på pgvector-utvidelsen.

        Må kjøre FØR 20241026-changelog.xml, som oppretter tabellen vector_store med
        en kolonne av typen vector(1536). Uten utvidelsen feiler den migrasjonen med
        'type "vector" does not exist'.

        includeAll sorterer filene på filnavn, og 00000000- kommer først.
    -->

    <changeSet id="00000000-1-enable-pgvector" author="opensource">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
        </preConditions>
        <sql>CREATE EXTENSION IF NOT EXISTS vector</sql>
        <rollback>
            <!-- Utvidelsen fjernes ikke automatisk: andre tabeller kan avhenge av den. -->
        </rollback>
    </changeSet>

</databaseChangeLog>
